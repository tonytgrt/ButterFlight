// ============================================================
// butterFlight_ui.mel
// ButterFlight Maya Plugin UI
// CIS 6600 Authoring Tool  --  Cecilia Chen & Yiding Tian
//
// Usage: source "butterFlight_ui.mel"; butterFlightUI;
// ============================================================

// ---- Global control-name variables --------------------------
global string $bf_rigField;
global string $bf_modeMenu;

// Path Following section
global string $bf_pathFrame;
global string $bf_pathField;
global string $bf_pathFromStartCheck;
global string $bf_pathSpeedEnableCheck;
global string $bf_pathSpeedField;
global string $bf_pathNoiseCheck;
global string $bf_pathNoiseAmpField;
global string $bf_pathDecelCheck;
global string $bf_pathDecelPctField;
global string $bf_pathDecelModeMenu;
global string $bf_pathAngleBlendCheck;
global string $bf_pathBlendRotXField;
global string $bf_pathBlendRotYField;
global string $bf_pathBlendRotZField;
global string $bf_pathBlendPctField;
global string $bf_pathBlendModeMenu;

// Butterfly velocity (applies to free flight and path following)
global string $bf_velocityField;

// Hover section
global string $bf_hoverFrame;
global string $bf_hoverUseRigCheck;
global string $bf_hoverPosXField;
global string $bf_hoverPosYField;
global string $bf_hoverPosZField;
global string $bf_hoverUseRigRotCheck;
global string $bf_hoverRotXField;
global string $bf_hoverRotYField;
global string $bf_hoverRotZField;
global string $bf_hoverNoiseCheck;
global string $bf_hoverNoiseAmpField;

// Swarm section
global string $bf_swarmFrame;
global string $bf_swarmEnableCheck;
global string $bf_agentCountField;
global string $bf_spawnSpreadField;
global string $bf_repulsionRadField;

// Output settings
global string $bf_startFrameField;
global string $bf_durationField;
global string $bf_flapPeriodField;
global string $bf_exportMenu;

// Follow Camera section
global string $bf_camEnableCheck;
global string $bf_camNameField;
global string $bf_camUseCurrentCheck;
global string $bf_camAutoFrameCheck;
global string $bf_camOffXField;
global string $bf_camOffYField;
global string $bf_camOffZField;
global string $bf_camRotXField;
global string $bf_camRotYField;
global string $bf_camRotZField;
global string $bf_camStiffSlider;
global string $bf_camFOVField;
global string $bf_camFillRatioSlider;

// Stationary Camera section
global string $bf_statCamEnableCheck;
global string $bf_statCamNameField;
global string $bf_statCamAutoZoomCheck;


// ============================================================
// Main window procedure
// ============================================================
global proc butterFlightUI()
{
    if (`window -exists butterFlightWin`)
        deleteUI butterFlightWin;

    window
        -title "ButterFlight v0.1"
        -widthHeight 360 720
        -sizeable true
        butterFlightWin;

    string $scroll = `scrollLayout
        -horizontalScrollBarThickness 0
        -verticalScrollBarThickness 14`;

    columnLayout -adjustableColumn true -rowSpacing 6 -columnOffset "both" 6;

        // ---- Banner -------------------------------------------
        text -label "ButterFlight" -font "boldLabelFont" -height 28;
        text -label "Realistic Butterfly Flight Simulation" -font "smallPlainLabelFont";
        separator -height 8 -style "in";


        // ---- 1. Rig Assignment --------------------------------
        frameLayout
            -label "1  Rig Assignment"
            -collapsable true
            -collapse false
            -marginWidth 6 -marginHeight 6;

            columnLayout -adjustableColumn true -rowSpacing 4;

                text -label "Butterfly Root Joint (BF_body):" -align "left";
                global string $bf_rigField;
                $bf_rigField = `textFieldButtonGrp
                    -label ""
                    -text ""
                    -buttonLabel "Select"
                    -buttonCommand "bfSelectRig"
                    -placeholderText "Select BF_body joint"
                    -columnWidth3 0 220 70`;

            setParent ..;  // columnLayout
        setParent ..;  // frameLayout


        // ---- 3. Simulation Mode -------------------------------
        frameLayout
            -label "3  Simulation Mode"
            -collapsable true
            -collapse false
            -marginWidth 6 -marginHeight 6;

            columnLayout -adjustableColumn true -rowSpacing 4;

                global string $bf_modeMenu;
                $bf_modeMenu = `optionMenuGrp
                    -label "Mode"
                    -changeCommand "bfUpdateMode"
                    -columnWidth2 100 200`;
                    menuItem -label "Free Flight";
                    menuItem -label "Path Following";
                    menuItem -label "Hover";

                global string $bf_velocityField;
                $bf_velocityField = `floatFieldGrp
                    -label "Velocity (m/s)"
                    -numberOfFields 1
                    -value1 0.5
                    -precision 3
                    -annotation "Butterfly cruise speed. Applies to both free flight (as max speed) and path following (as cursor rate). 0 = use legacy defaults."
                    -columnWidth2 120 160`;

            setParent ..;
        setParent ..;


        // ---- 4. Path Following Settings (conditional) ---------
        global string $bf_pathFrame;
        $bf_pathFrame = `frameLayout
            -label "4  Path Settings"
            -collapsable true
            -collapse false
            -visible false
            -marginWidth 6 -marginHeight 6`;

            columnLayout -adjustableColumn true -rowSpacing 4;

                text -label "Guide Curve (NURBS):" -align "left";
                global string $bf_pathField;
                $bf_pathField = `textFieldButtonGrp
                    -label ""
                    -text ""
                    -buttonLabel "Select"
                    -buttonCommand "bfSelectPath"
                    -placeholderText "Select NURBS curve"
                    -columnWidth3 0 220 70`;

                // --- Start location on curve ---------------------------
                // Off (default): snap to the point on the curve nearest
                //  the butterfly's current rig position.
                // On: always start from the curve's first CV.
                global string $bf_pathFromStartCheck;
                $bf_pathFromStartCheck = `checkBoxGrp
                    -label "Start from Path Start"
                    -value1 false
                    -annotation "If off, snap to the nearest point on the curve. If on, always begin at the curve's first CV."`;

                // --- Path Speed Scale (optional override of Velocity) ---
                // When enabled, cursor rate is derived from curve length
                // and duration instead of the Velocity (m/s) field.
                global string $bf_pathSpeedEnableCheck;
                $bf_pathSpeedEnableCheck = `checkBoxGrp
                    -label "Use Path Speed Scale"
                    -value1 false
                    -onCommand  "bfPathSpeedToggle 1"
                    -offCommand "bfPathSpeedToggle 0"
                    -annotation "If on, disables Velocity in Simulation and drives cursor rate from curve length × scale ÷ duration"`;

                global string $bf_pathSpeedField;
                $bf_pathSpeedField = `floatFieldGrp
                    -label "Path Speed Scale"
                    -numberOfFields 1
                    -value1 1.0
                    -precision 3
                    -enable false
                    -annotation "Multiplier for auto-derived path speed (1.0 = remaining curve length over full duration)"
                    -columnWidth2 140 140`;

                global string $bf_pathNoiseCheck;
                $bf_pathNoiseCheck = `checkBoxGrp
                    -label "Path Noise"
                    -value1 false
                    -annotation "Add a smooth left/right swing so the butterfly doesn't track the curve mechanically"`;

                global string $bf_pathNoiseAmpField;
                $bf_pathNoiseAmpField = `floatFieldGrp
                    -label "Noise Amplitude (cm)"
                    -numberOfFields 1
                    -value1 5.0
                    -precision 2
                    -annotation "Lateral swing amplitude in Maya cm"
                    -columnWidth2 140 140`;

                separator -height 6 -style "in";
                text -label "Deceleration:" -align "left" -font "boldLabelFont";

                global string $bf_pathDecelCheck;
                $bf_pathDecelCheck = `checkBoxGrp
                    -label "Enable Deceleration"
                    -value1 false
                    -onCommand  "bfPathDecelToggle 1"
                    -offCommand "bfPathDecelToggle 0"
                    -annotation "Smoothly fade cursor speed to zero near the end of the path so the butterfly comes to rest instead of still moving on the final frame"`;

                global string $bf_pathDecelPctField;
                $bf_pathDecelPctField = `floatFieldGrp
                    -label "Decel Window (%)"
                    -numberOfFields 1
                    -value1 10.0
                    -precision 2
                    -enable false
                    -annotation "Size of the decel window as a percentage of the total path (e.g. 10 = last 10% of the path is the decel zone)"
                    -columnWidth2 140 140`;

                global string $bf_pathDecelModeMenu;
                $bf_pathDecelModeMenu = `optionMenuGrp
                    -label "Fade Mode"
                    -enable false
                    -annotation "Linear = constant deceleration; Exponential = quick initial slowdown then gentle tail"
                    -columnWidth2 140 160`;
                    menuItem -label "Linear";
                    menuItem -label "Exponential";
                optionMenuGrp -edit -select 2 $bf_pathDecelModeMenu;

                separator -height 6 -style "in";
                text -label "Angle Blend:" -align "left" -font "boldLabelFont";

                global string $bf_pathAngleBlendCheck;
                $bf_pathAngleBlendCheck = `checkBoxGrp
                    -label "Enable Angle Blend"
                    -value1 false
                    -onCommand  "bfPathAngleBlendToggle 1"
                    -offCommand "bfPathAngleBlendToggle 0"
                    -annotation "Quaternion-slerp the BF_thorax rotation from the path-derived pose toward the EXACT (rotateX, rotateY, rotateZ) values below over the last N% of the path"`;

                global string $bf_pathBlendRotXField;
                $bf_pathBlendRotXField = `floatFieldGrp
                    -label "Final Rotate X (deg)"
                    -numberOfFields 1
                    -value1 0.0
                    -precision 2
                    -enable false
                    -annotation "Exact target value for BF_thorax.rotateX on the final frame"
                    -columnWidth2 140 140`;

                global string $bf_pathBlendRotYField;
                $bf_pathBlendRotYField = `floatFieldGrp
                    -label "Final Rotate Y (deg)"
                    -numberOfFields 1
                    -value1 0.0
                    -precision 2
                    -enable false
                    -annotation "Exact target value for BF_thorax.rotateY on the final frame"
                    -columnWidth2 140 140`;

                global string $bf_pathBlendRotZField;
                $bf_pathBlendRotZField = `floatFieldGrp
                    -label "Final Rotate Z (deg)"
                    -numberOfFields 1
                    -value1 0.0
                    -precision 2
                    -enable false
                    -annotation "Exact target value for BF_thorax.rotateZ on the final frame"
                    -columnWidth2 140 140`;

                global string $bf_pathBlendPctField;
                $bf_pathBlendPctField = `floatFieldGrp
                    -label "Blend Window (%)"
                    -numberOfFields 1
                    -value1 10.0
                    -precision 2
                    -enable false
                    -annotation "Size of the angle blend window as a percentage of the total path (e.g. 10 = last 10% of the path)"
                    -columnWidth2 140 140`;

                global string $bf_pathBlendModeMenu;
                $bf_pathBlendModeMenu = `optionMenuGrp
                    -label "Blend Mode"
                    -enable false
                    -annotation "Linear = constant turn rate; Exponential = quick initial turn then gentle settle"
                    -columnWidth2 140 160`;
                    menuItem -label "Linear";
                    menuItem -label "Exponential";
                optionMenuGrp -edit -select 2 $bf_pathBlendModeMenu;

            setParent ..;
        setParent ..;


        // ---- 4b. Hover Settings (conditional) -------------------
        global string $bf_hoverFrame;
        $bf_hoverFrame = `frameLayout
            -label "4b  Hover Settings"
            -collapsable true
            -collapse false
            -visible false
            -marginWidth 6 -marginHeight 6`;

            columnLayout -adjustableColumn true -rowSpacing 4;

                global string $bf_hoverUseRigCheck;
                $bf_hoverUseRigCheck = `checkBoxGrp
                    -label "Use Current Rig Position"
                    -value1 true
                    -onCommand  "bfHoverToggle 0"
                    -offCommand "bfHoverToggle 1"`;

                global string $bf_hoverPosXField;
                $bf_hoverPosXField = `floatFieldGrp
                    -label "Position X (cm)"
                    -numberOfFields 1
                    -value1 0.0
                    -precision 3
                    -enable false
                    -columnWidth2 120 160`;

                global string $bf_hoverPosYField;
                $bf_hoverPosYField = `floatFieldGrp
                    -label "Position Y (cm)"
                    -numberOfFields 1
                    -value1 0.0
                    -precision 3
                    -enable false
                    -columnWidth2 120 160`;

                global string $bf_hoverPosZField;
                $bf_hoverPosZField = `floatFieldGrp
                    -label "Position Z (cm)"
                    -numberOfFields 1
                    -value1 0.0
                    -precision 3
                    -enable false
                    -columnWidth2 120 160`;

                separator -height 6 -style "in";

                global string $bf_hoverUseRigRotCheck;
                $bf_hoverUseRigRotCheck = `checkBoxGrp
                    -label "Use Current Rig Rotation"
                    -value1 true
                    -onCommand  "bfHoverRotToggle 0"
                    -offCommand "bfHoverRotToggle 1"`;

                global string $bf_hoverRotXField;
                $bf_hoverRotXField = `floatFieldGrp
                    -label "Roll (deg)"
                    -numberOfFields 1
                    -value1 0.0
                    -precision 3
                    -enable false
                    -annotation "Body roll angle (tilt left/right)"
                    -columnWidth2 120 160`;

                global string $bf_hoverRotYField;
                $bf_hoverRotYField = `floatFieldGrp
                    -label "Yaw (deg)"
                    -numberOfFields 1
                    -value1 0.0
                    -precision 3
                    -enable false
                    -annotation "Body yaw/heading angle (0 = facing -Z)"
                    -columnWidth2 120 160`;

                global string $bf_hoverRotZField;
                $bf_hoverRotZField = `floatFieldGrp
                    -label "Pitch (deg)"
                    -numberOfFields 1
                    -value1 0.0
                    -precision 3
                    -enable false
                    -annotation "Body pitch angle (nose up/down)"
                    -columnWidth2 120 160`;

                separator -height 6 -style "in";
                text -label "Hover Noise:" -align "left" -font "boldLabelFont";

                global string $bf_hoverNoiseCheck;
                $bf_hoverNoiseCheck = `checkBoxGrp
                    -label "Enable Hover Noise"
                    -value1 false
                    -onCommand  "bfHoverNoiseToggle 1"
                    -offCommand "bfHoverNoiseToggle 0"
                    -annotation "Slowly drift the butterfly around the hover position so it doesn't appear locked in space"`;

                global string $bf_hoverNoiseAmpField;
                $bf_hoverNoiseAmpField = `floatFieldGrp
                    -label "Noise Amplitude (cm)"
                    -numberOfFields 1
                    -value1 5.0
                    -precision 2
                    -enable false
                    -annotation "Peak per-axis drift in Maya cm (X/Y/Z each oscillate up to this much)"
                    -columnWidth2 140 140`;

            setParent ..;
        setParent ..;


        // ---- 7. Swarm Settings (independent of mode) -----------
        global string $bf_swarmFrame;
        $bf_swarmFrame = `frameLayout
            -label "7  Swarm Settings"
            -collapsable true
            -collapse false
            -marginWidth 6 -marginHeight 6`;

            columnLayout -adjustableColumn true -rowSpacing 4;

                global string $bf_swarmEnableCheck;
                $bf_swarmEnableCheck = `checkBoxGrp
                    -label "Enable Swarm"
                    -value1 false
                    -onCommand  "bfSwarmToggle 1"
                    -offCommand "bfSwarmToggle 0"`;

                global string $bf_agentCountField;
                $bf_agentCountField = `intFieldGrp
                    -label "Agent Count"
                    -numberOfFields 1
                    -value1 10
                    -enable false
                    -columnWidth2 100 180`;

                global string $bf_spawnSpreadField;
                $bf_spawnSpreadField = `floatFieldGrp
                    -label "Spawn Spread (cm)"
                    -numberOfFields 1
                    -value1 200.0
                    -precision 1
                    -enable false
                    -columnWidth2 120 160`;

                global string $bf_repulsionRadField;
                $bf_repulsionRadField = `floatFieldGrp
                    -label "Repulsion Radius (cm)"
                    -numberOfFields 1
                    -value1 50.0
                    -precision 1
                    -enable false
                    -columnWidth2 120 160`;

            setParent ..;
        setParent ..;


        // ---- 8. Output Settings -------------------------------
        frameLayout
            -label "8  Output Settings"
            -collapsable true
            -collapse false
            -marginWidth 6 -marginHeight 6;

            columnLayout -adjustableColumn true -rowSpacing 4;

                global string $bf_startFrameField;
                $bf_startFrameField = `intFieldGrp
                    -label "Start Frame"
                    -numberOfFields 1
                    -value1 1
                    -columnWidth2 100 180`;

                global string $bf_durationField;
                $bf_durationField = `intFieldGrp
                    -label "Duration (frames)"
                    -numberOfFields 1
                    -value1 120
                    -columnWidth2 120 160`;

                global string $bf_flapPeriodField;
                $bf_flapPeriodField = `floatFieldGrp
                    -label "Flap Period (sec)"
                    -numberOfFields 1
                    -value1 1.0
                    -precision 3
                    -annotation "Playback seconds per flap cycle (hovering baseline)"
                    -columnWidth2 140 140`;

                global string $bf_exportMenu;
                $bf_exportMenu = `optionMenuGrp
                    -label "Export Format"
                    -columnWidth2 100 200`;
                    menuItem -label "Maya Keyframes (default)";
                    menuItem -label "Alembic (.abc)";
                    menuItem -label "FBX (.fbx)";

            setParent ..;
        setParent ..;


        // ---- 9. Follow Camera ---------------------------------
        frameLayout
            -label "9  Follow Camera"
            -collapsable true
            -collapse true
            -marginWidth 6 -marginHeight 6;

            columnLayout -adjustableColumn true -rowSpacing 4;

                global string $bf_camEnableCheck;
                $bf_camEnableCheck = `checkBoxGrp
                    -label "Create Follow Camera"
                    -value1 false
                    -onCommand  "bfCameraToggle 1"
                    -offCommand "bfCameraToggle 0"
                    -annotation "Bake a spring-arm camera that follows the butterfly"`;

                global string $bf_camNameField;
                $bf_camNameField = `textFieldGrp
                    -label "Camera Name"
                    -text "BF_followCam"
                    -enable false
                    -columnWidth2 120 160`;

                global string $bf_camUseCurrentCheck;
                $bf_camUseCurrentCheck = `checkBoxGrp
                    -label "Use Current Cam Trans"
                    -value1 false
                    -enable false
                    -onCommand  "bfCameraUseCurrentToggle 1"
                    -offCommand "bfCameraUseCurrentToggle 0"
                    -annotation "Derive follow-cam offset, rotation and FOV from the active viewport camera so the frame-0 view matches what you see now"`;

                global string $bf_camAutoFrameCheck;
                $bf_camAutoFrameCheck = `checkBoxGrp
                    -label "Auto Frame Distance"
                    -value1 true
                    -enable false
                    -onCommand  "bfCameraAutoFrameToggle 1"
                    -offCommand "bfCameraAutoFrameToggle 0"
                    -annotation "Auto-compute Z offset from FOV and wingspan"`;

                global string $bf_camFillRatioSlider;
                $bf_camFillRatioSlider = `floatSliderGrp
                    -label "Frame Fill Ratio"
                    -field true
                    -minValue 0.3
                    -maxValue 1.0
                    -fieldMinValue 0.1
                    -fieldMaxValue 1.0
                    -value 0.7
                    -precision 2
                    -enable false
                    -annotation "Portion of the frame the butterfly should occupy"
                    -columnWidth3 100 60 140`;

                separator -height 6 -style "in";

                text -label "Local Offset (cm)  [+Z = behind]:" -align "left";

                global string $bf_camOffXField;
                $bf_camOffXField = `floatFieldGrp
                    -label "Offset X"
                    -numberOfFields 1
                    -value1 0.0
                    -precision 3
                    -enable false
                    -columnWidth2 100 180`;

                global string $bf_camOffYField;
                $bf_camOffYField = `floatFieldGrp
                    -label "Offset Y"
                    -numberOfFields 1
                    -value1 5.0
                    -precision 3
                    -enable false
                    -columnWidth2 100 180`;

                global string $bf_camOffZField;
                $bf_camOffZField = `floatFieldGrp
                    -label "Offset Z"
                    -numberOfFields 1
                    -value1 30.0
                    -precision 3
                    -enable false
                    -annotation "Distance behind the butterfly (auto-computed when Auto Frame is on)"
                    -columnWidth2 100 180`;

                separator -height 6 -style "in";

                text -label "Rotation Offset (deg):" -align "left";

                global string $bf_camRotXField;
                $bf_camRotXField = `floatFieldGrp
                    -label "Rot X (pitch)"
                    -numberOfFields 1
                    -value1 0.0
                    -precision 3
                    -enable false
                    -columnWidth2 100 180`;

                global string $bf_camRotYField;
                $bf_camRotYField = `floatFieldGrp
                    -label "Rot Y (yaw)"
                    -numberOfFields 1
                    -value1 0.0
                    -precision 3
                    -enable false
                    -columnWidth2 100 180`;

                global string $bf_camRotZField;
                $bf_camRotZField = `floatFieldGrp
                    -label "Rot Z (roll)"
                    -numberOfFields 1
                    -value1 0.0
                    -precision 3
                    -enable false
                    -columnWidth2 100 180`;

                separator -height 6 -style "in";

                global string $bf_camStiffSlider;
                $bf_camStiffSlider = `floatSliderGrp
                    -label "Spring Stiffness"
                    -field true
                    -minValue 0.5
                    -maxValue 30.0
                    -fieldMinValue 0.1
                    -fieldMaxValue 100.0
                    -value 10.0
                    -precision 2
                    -enable false
                    -annotation "Higher = snappier follow, lower = more lag"
                    -columnWidth3 100 60 140`;

                global string $bf_camFOVField;
                $bf_camFOVField = `floatFieldGrp
                    -label "Camera FOV (deg)"
                    -numberOfFields 1
                    -value1 35.0
                    -precision 2
                    -enable false
                    -columnWidth2 120 160`;

            setParent ..;
        setParent ..;


        // ---- 10. Stationary Camera ----------------------------
        frameLayout
            -label "10  Stationary Camera"
            -collapsable true
            -collapse true
            -marginWidth 6 -marginHeight 6;

            columnLayout -adjustableColumn true -rowSpacing 4;

                global string $bf_statCamEnableCheck;
                $bf_statCamEnableCheck = `checkBoxGrp
                    -label "Create Stationary Camera"
                    -value1 false
                    -onCommand  "bfStatCamToggle 1"
                    -offCommand "bfStatCamToggle 0"
                    -annotation "Create a tripod-style camera fixed at the current viewport camera's position that rotates each frame to keep the butterfly at the same screen offset"`;

                global string $bf_statCamNameField;
                $bf_statCamNameField = `textFieldGrp
                    -label "Camera Name"
                    -text "BF_statCam"
                    -enable false
                    -columnWidth2 120 160`;

                global string $bf_statCamAutoZoomCheck;
                $bf_statCamAutoZoomCheck = `checkBoxGrp
                    -label "Auto Zoom"
                    -value1 false
                    -enable false
                    -annotation "Automatically key focal length each frame so the butterfly fills the same fraction of the frame as at setup time"`;

                text -label "Position and FOV are captured from the" -align "left" -font "smallPlainLabelFont";
                text -label "current viewport camera when simulating." -align "left" -font "smallPlainLabelFont";

            setParent ..;
        setParent ..;


        // ---- Action Buttons -----------------------------------
        separator -height 10 -style "in";

        rowLayout
            -numberOfColumns 3
            -columnWidth3 112 112 112
            -columnAlign3 "center" "center" "center"
            -adjustableColumn 2;

            button
                -label "Simulate"
                -backgroundColor 0.2 0.5 0.2
                -command "bfSimulateCallback"
                -annotation "Run the butterfly flight simulation"
                -width 108;

            button
                -label "Reset"
                -backgroundColor 0.2 0.3 0.55
                -command "bfReset"
                -annotation "Restore all UI fields to their default values"
                -width 108;

            button
                -label "Delete All Keys"
                -backgroundColor 0.5 0.2 0.2
                -command "bfDeleteAllKeys"
                -annotation "Remove every animation key from the rig hierarchy and any baked ButterFlight cameras"
                -width 108;

        setParent ..;  // rowLayout

        separator -height 6 -style "none";
        text -label "Chen et al. 2022  |  CIS 6600" -font "tinyBoldLabelFont" -align "center";

    setParent ..;  // columnLayout
    setParent ..;  // scrollLayout

    showWindow butterFlightWin;

    // Apply initial defaults
    optionMenuGrp -edit -select 3 $bf_modeMenu;
    bfUpdateMode;
}


// ============================================================
// Callback: Select rig root joint
// ============================================================
global proc bfSelectRig()
{
    global string $bf_rigField;
    string $sel[] = `ls -selection -type joint`;
    if (size($sel) == 0) {
        confirmDialog
            -title "ButterFlight"
            -message "Please select the BF_body root joint first."
            -button "OK";
        return;
    }
    string $joint = $sel[0];
    textFieldButtonGrp -edit -text $joint $bf_rigField;
}


// ============================================================
// Callback: Select path curve
// ============================================================
global proc bfSelectPath()
{
    global string $bf_pathField;
    string $sel[] = `ls -selection -type nurbsCurve`;
    if (size($sel) == 0) {
        // Try transform that contains a nurbsCurve shape
        string $shapes[] = `ls -selection -dagObjects -type nurbsCurve`;
        if (size($shapes) == 0) {
            confirmDialog
                -title "ButterFlight"
                -message "Please select a NURBS curve to use as the flight path."
                -button "OK";
            return;
        }
        $sel[0] = $shapes[0];
    }
    textFieldButtonGrp -edit -text $sel[0] $bf_pathField;
}


// ============================================================
// Callback: Simulation mode changed
// ============================================================
global proc bfUpdateMode()
{
    global string $bf_modeMenu;
    global string $bf_pathFrame;
    global string $bf_swarmFrame;
    global string $bf_hoverFrame;

    int $idx = `optionMenuGrp -query -select $bf_modeMenu`;
    // 1=Free Flight, 2=Path Following, 3=Hover
    frameLayout -edit -visible ($idx == 2) $bf_pathFrame;
    frameLayout -edit -visible ($idx == 3) $bf_hoverFrame;

    // Velocity field enable depends on mode + path-speed-scale toggle
    bfRefreshVelocityEnable();
}


// ============================================================
// Callback: Path Speed Scale enable toggled
// ============================================================
global proc bfPathSpeedToggle(int $state)
{
    global string $bf_pathSpeedField;
    floatFieldGrp -edit -enable $state $bf_pathSpeedField;
    bfRefreshVelocityEnable();
}


// ============================================================
// Callback: Path Deceleration enable toggled
// ============================================================
global proc bfPathDecelToggle(int $state)
{
    global string $bf_pathDecelPctField;
    global string $bf_pathDecelModeMenu;
    floatFieldGrp -edit -enable $state $bf_pathDecelPctField;
    optionMenuGrp -edit -enable $state $bf_pathDecelModeMenu;
}


// ============================================================
// Callback: Path Angle Blend enable toggled
// ============================================================
global proc bfPathAngleBlendToggle(int $state)
{
    global string $bf_pathBlendRotXField;
    global string $bf_pathBlendRotYField;
    global string $bf_pathBlendRotZField;
    global string $bf_pathBlendPctField;
    global string $bf_pathBlendModeMenu;
    floatFieldGrp -edit -enable $state $bf_pathBlendRotXField;
    floatFieldGrp -edit -enable $state $bf_pathBlendRotYField;
    floatFieldGrp -edit -enable $state $bf_pathBlendRotZField;
    floatFieldGrp -edit -enable $state $bf_pathBlendPctField;
    optionMenuGrp -edit -enable $state $bf_pathBlendModeMenu;
}


// ============================================================
// Helper: recompute Velocity-field enable state
// Velocity is disabled only when Path Following mode is active AND
// the Use Path Speed Scale toggle is on.
// ============================================================
global proc bfRefreshVelocityEnable()
{
    global string $bf_modeMenu;
    global string $bf_pathSpeedEnableCheck;
    global string $bf_velocityField;

    int $mode    = `optionMenuGrp -query -select $bf_modeMenu`;
    int $scaleOn = `checkBoxGrp   -query -value1 $bf_pathSpeedEnableCheck`;
    int $velEnable = ($mode != 2 || !$scaleOn);
    floatFieldGrp -edit -enable $velEnable $bf_velocityField;
}


// ============================================================
// Callback: Hover position field enable/disable
// ============================================================
global proc bfHoverToggle(int $state)
{
    global string $bf_hoverPosXField;
    global string $bf_hoverPosYField;
    global string $bf_hoverPosZField;

    floatFieldGrp -edit -enable $state $bf_hoverPosXField;
    floatFieldGrp -edit -enable $state $bf_hoverPosYField;
    floatFieldGrp -edit -enable $state $bf_hoverPosZField;
}


// ============================================================
// Callback: Hover rotation field enable/disable
// ============================================================
global proc bfHoverRotToggle(int $state)
{
    global string $bf_hoverRotXField;
    global string $bf_hoverRotYField;
    global string $bf_hoverRotZField;

    floatFieldGrp -edit -enable $state $bf_hoverRotXField;
    floatFieldGrp -edit -enable $state $bf_hoverRotYField;
    floatFieldGrp -edit -enable $state $bf_hoverRotZField;
}


// ============================================================
// Callback: Hover Noise enable toggled
// ============================================================
global proc bfHoverNoiseToggle(int $state)
{
    global string $bf_hoverNoiseAmpField;
    floatFieldGrp -edit -enable $state $bf_hoverNoiseAmpField;
}


// ============================================================
// Callback: Swarm enable/disable toggle
// ============================================================
global proc bfSwarmToggle(int $state)
{
    global string $bf_agentCountField;
    global string $bf_spawnSpreadField;
    global string $bf_repulsionRadField;

    intFieldGrp   -edit -enable $state $bf_agentCountField;
    floatFieldGrp -edit -enable $state $bf_spawnSpreadField;
    floatFieldGrp -edit -enable $state $bf_repulsionRadField;
}

// Callback: Follow-camera master enable toggle
// ============================================================
global proc bfCameraToggle(int $state)
{
    global string $bf_camNameField;
    global string $bf_camUseCurrentCheck;
    global string $bf_camAutoFrameCheck;
    global string $bf_camFillRatioSlider;
    global string $bf_camOffXField;
    global string $bf_camOffYField;
    global string $bf_camOffZField;
    global string $bf_camRotXField;
    global string $bf_camRotYField;
    global string $bf_camRotZField;
    global string $bf_camStiffSlider;
    global string $bf_camFOVField;

    textFieldGrp    -edit -enable $state $bf_camNameField;
    checkBoxGrp     -edit -enable $state $bf_camUseCurrentCheck;
    floatSliderGrp  -edit -enable $state $bf_camStiffSlider;

    if ($state == 1) {
        // Child widgets are driven by the "Use Current Camera" toggle:
        // when it's on, manual offset/rotation/FOV/auto-frame are overridden.
        int $uc = `checkBoxGrp -query -value1 $bf_camUseCurrentCheck`;
        bfCameraUseCurrentToggle $uc;
    } else {
        checkBoxGrp    -edit -enable 0 $bf_camAutoFrameCheck;
        floatFieldGrp  -edit -enable 0 $bf_camOffXField;
        floatFieldGrp  -edit -enable 0 $bf_camOffYField;
        floatFieldGrp  -edit -enable 0 $bf_camOffZField;
        floatFieldGrp  -edit -enable 0 $bf_camRotXField;
        floatFieldGrp  -edit -enable 0 $bf_camRotYField;
        floatFieldGrp  -edit -enable 0 $bf_camRotZField;
        floatFieldGrp  -edit -enable 0 $bf_camFOVField;
        floatSliderGrp -edit -enable 0 $bf_camFillRatioSlider;
    }
}


// ============================================================
// Callback: Use-Current-Camera toggle — when ON, the manual offset,
// rotation, auto-frame and FOV fields are disabled because they will
// be derived from the active viewport camera at simulate time.
// ============================================================
global proc bfCameraUseCurrentToggle(int $state)
{
    global string $bf_camAutoFrameCheck;
    global string $bf_camFillRatioSlider;
    global string $bf_camOffXField;
    global string $bf_camOffYField;
    global string $bf_camOffZField;
    global string $bf_camRotXField;
    global string $bf_camRotYField;
    global string $bf_camRotZField;
    global string $bf_camFOVField;

    int $manual = (1 - $state);  // enable manual fields only when NOT using current

    checkBoxGrp    -edit -enable $manual $bf_camAutoFrameCheck;
    floatFieldGrp  -edit -enable $manual $bf_camOffXField;
    floatFieldGrp  -edit -enable $manual $bf_camOffYField;
    floatFieldGrp  -edit -enable $manual $bf_camRotXField;
    floatFieldGrp  -edit -enable $manual $bf_camRotYField;
    floatFieldGrp  -edit -enable $manual $bf_camRotZField;
    floatFieldGrp  -edit -enable $manual $bf_camFOVField;

    if ($manual) {
        // Defer Z-offset / fill-ratio to the auto-frame sub-toggle.
        int $af = `checkBoxGrp -query -value1 $bf_camAutoFrameCheck`;
        bfCameraAutoFrameToggle $af;
    } else {
        floatFieldGrp  -edit -enable 0 $bf_camOffZField;
        floatSliderGrp -edit -enable 0 $bf_camFillRatioSlider;
    }
}


// ============================================================
// Callback: Stationary-camera master enable toggle
// ============================================================
global proc bfStatCamToggle(int $state)
{
    global string $bf_statCamNameField;
    global string $bf_statCamAutoZoomCheck;
    textFieldGrp -edit -enable $state $bf_statCamNameField;
    checkBoxGrp  -edit -enable $state $bf_statCamAutoZoomCheck;
}


// ============================================================
// Callback: Auto-frame toggle (enables/disables Z offset field)
// ============================================================
global proc bfCameraAutoFrameToggle(int $state)
{
    global string $bf_camOffZField;
    global string $bf_camFillRatioSlider;

    // When auto-frame is ON, manual Z is disabled and fill ratio drives it.
    floatFieldGrp  -edit -enable (1 - $state) $bf_camOffZField;
    floatSliderGrp -edit -enable $state       $bf_camFillRatioSlider;
}


// ============================================================
// Helper: compute auto-frame Z distance from FOV + wingspan
//   distance = (wingspan/2) / (fillRatio * tan(fovDeg/2 * pi/180))
// ============================================================
global proc float bfCameraAutoDistance(float $fovDeg, float $fillRatio,
                                       float $wingspanCm)
{
    if ($fillRatio <= 0.0) $fillRatio = 0.7;
    if ($fovDeg   <= 1.0) $fovDeg    = 35.0;
    float $halfFovRad = ($fovDeg * 0.5) * (3.14159265358979 / 180.0);
    float $tanHalf = tan($halfFovRad);
    if ($tanHalf < 1e-6) $tanHalf = 1e-6;
    float $dist = ($wingspanCm * 0.5) / ($fillRatio * $tanHalf);
    return $dist;
}


// ============================================================
// Callback: Simulate button
// ============================================================
global proc bfSimulateCallback()
{
    global string $bf_rigField;
    global string $bf_modeMenu;
    global string $bf_pathField;
    global string $bf_pathFromStartCheck;
    global string $bf_pathSpeedEnableCheck;
    global string $bf_pathSpeedField;
    global string $bf_pathNoiseCheck;
    global string $bf_pathNoiseAmpField;
    global string $bf_pathDecelCheck;
    global string $bf_pathDecelPctField;
    global string $bf_pathDecelModeMenu;
    global string $bf_pathAngleBlendCheck;
    global string $bf_pathBlendRotXField;
    global string $bf_pathBlendRotYField;
    global string $bf_pathBlendRotZField;
    global string $bf_pathBlendPctField;
    global string $bf_pathBlendModeMenu;
    global string $bf_velocityField;
    global string $bf_hoverUseRigCheck;
    global string $bf_hoverPosXField;
    global string $bf_hoverPosYField;
    global string $bf_hoverPosZField;
    global string $bf_hoverUseRigRotCheck;
    global string $bf_hoverRotXField;
    global string $bf_hoverRotYField;
    global string $bf_hoverRotZField;
    global string $bf_hoverNoiseCheck;
    global string $bf_hoverNoiseAmpField;
    global string $bf_startFrameField;
    global string $bf_durationField;
    global string $bf_flapPeriodField;
    global string $bf_camEnableCheck;
    global string $bf_camNameField;
    global string $bf_camUseCurrentCheck;
    global string $bf_camAutoFrameCheck;
    global string $bf_camOffXField;
    global string $bf_camOffYField;
    global string $bf_camOffZField;
    global string $bf_camRotXField;
    global string $bf_camRotYField;
    global string $bf_camRotZField;
    global string $bf_camStiffSlider;
    global string $bf_camFOVField;
    global string $bf_camFillRatioSlider;
    global string $bf_statCamEnableCheck;
    global string $bf_statCamNameField;
    global string $bf_statCamAutoZoomCheck;

    // --- Validation ---
    string $rig = `textFieldButtonGrp -query -text $bf_rigField`;
    if ($rig == "") {
        confirmDialog
            -title "ButterFlight"
            -message "No rig assigned. Please select the BF_body root joint."
            -button "OK";
        return;
    }
    if (!`objExists $rig`) {
        confirmDialog
            -title "ButterFlight"
            -message ("Joint \"" + $rig + "\" does not exist in scene.")
            -button "OK";
        return;
    }

    // --- Gather parameters ---
    int    $mode      = `optionMenuGrp -query -select $bf_modeMenu`;
    int    $startF    = `intFieldGrp    -query -value1 $bf_startFrameField`;
    int    $duration  = `intFieldGrp    -query -value1 $bf_durationField`;
    float  $flapPeriod = `floatFieldGrp -query -value1 $bf_flapPeriodField`;

    print ("// ButterFlight: Starting simulation on rig: " + $rig + "\n");
    print ("//   Mode:       " + $mode      + "\n");
    print ("//   Flap Period: " + $flapPeriod + " sec\n");
    print ("//   Frames:     " + $startF + " to " + ($startF + $duration - 1) + "\n");

    // Build path flags only when in Path Following mode (mode 2)
    string $path = `textFieldButtonGrp -query -text $bf_pathField`;
    string $pathFlag = "";
    int    $pathScaleOn = 0;
    if ($path != "" && $mode == 2) {
        $pathFlag = " -path \"" + $path + "\"";
        int $fromStart = `checkBoxGrp -query -value1 $bf_pathFromStartCheck`;
        $pathFlag += " -pathFromStart " + $fromStart;
        // When "Use Path Speed Scale" is checked, derive cursor rate
        // from remaining curve length × scale ÷ duration instead of velocity.
        $pathScaleOn = `checkBoxGrp -query -value1 $bf_pathSpeedEnableCheck`;
        if ($pathScaleOn) {
            float $psScale = `floatFieldGrp -query -value1 $bf_pathSpeedField`;
            $pathFlag += " -pathSpeed " + $psScale;
        }
        int $pNoise = `checkBoxGrp -query -value1 $bf_pathNoiseCheck`;
        $pathFlag += " -pathNoise " + $pNoise;
        if ($pNoise) {
            float $pnAmp = `floatFieldGrp -query -value1 $bf_pathNoiseAmpField`;
            $pathFlag += " -pathNoiseAmp " + $pnAmp;
        }
        int $pDecel = `checkBoxGrp -query -value1 $bf_pathDecelCheck`;
        $pathFlag += " -pathDecel " + $pDecel;
        if ($pDecel) {
            float $pdp = `floatFieldGrp -query -value1 $bf_pathDecelPctField`;
            int   $pdm = `optionMenuGrp -query -select $bf_pathDecelModeMenu`;
            // Menu is 1-indexed (1=Linear, 2=Exponential);
            // C++ expects 0=linear, 1=exponential.
            int $pdmCpp = $pdm - 1;
            $pathFlag += " -pathDecelPct " + $pdp + " -pathDecelMode " + $pdmCpp;
        }
        int $pAB = `checkBoxGrp -query -value1 $bf_pathAngleBlendCheck`;
        $pathFlag += " -pathAngleBlend " + $pAB;
        if ($pAB) {
            float $prx = `floatFieldGrp -query -value1 $bf_pathBlendRotXField`;
            float $pry = `floatFieldGrp -query -value1 $bf_pathBlendRotYField`;
            float $prz = `floatFieldGrp -query -value1 $bf_pathBlendRotZField`;
            float $pbp = `floatFieldGrp -query -value1 $bf_pathBlendPctField`;
            int   $pbm = `optionMenuGrp -query -select $bf_pathBlendModeMenu`;
            int $pbmCpp = $pbm - 1;
            $pathFlag += " -pathBlendRotX " + $prx
                       + " -pathBlendRotY " + $pry
                       + " -pathBlendRotZ " + $prz
                       + " -pathBlendPct "  + $pbp
                       + " -pathBlendMode " + $pbmCpp;
        }
    }

    // Build swarm flags (independent of mode)
    global string $bf_swarmEnableCheck;
    global string $bf_agentCountField;
    global string $bf_spawnSpreadField;
    global string $bf_repulsionRadField;

    string $swarmFlag = "";
    int $swarmEnabled = `checkBoxGrp -query -value1 $bf_swarmEnableCheck`;
    if ($swarmEnabled) {
        int    $agents    = `intFieldGrp   -query -value1 $bf_agentCountField`;
        float  $spread    = `floatFieldGrp -query -value1 $bf_spawnSpreadField`;
        float  $repulsion = `floatFieldGrp -query -value1 $bf_repulsionRadField`;
        $swarmFlag = " -agentCount " + $agents
                   + " -spawnSpread " + $spread
                   + " -repulsionRadius " + $repulsion;
    }

    // Map MEL mode index to C++ mode: 1=Free, 2=Path, 3=Hover→4
    int $cppMode = $mode;
    if ($mode == 3) $cppMode = 4;

    // Build velocity flag (applies to free flight and path following).
    // 0 or negative = use built-in defaults; otherwise pass through.
    // Suppressed in path mode when the Path Speed Scale toggle is on —
    // scale takes over in that case.
    string $velFlag = "";
    float $velocity = `floatFieldGrp -query -value1 $bf_velocityField`;
    if ($velocity > 0.0 && ($mode == 1 || ($mode == 2 && !$pathScaleOn))) {
        $velFlag = " -velocity " + $velocity;
    }

    // Build hover flags
    string $hoverFlag = "";
    if ($mode == 3) {
        $hoverFlag = " -mode 4";
        int $useRig = `checkBoxGrp -query -value1 $bf_hoverUseRigCheck`;
        if (!$useRig) {
            float $hx = `floatFieldGrp -query -value1 $bf_hoverPosXField`;
            float $hy = `floatFieldGrp -query -value1 $bf_hoverPosYField`;
            float $hz = `floatFieldGrp -query -value1 $bf_hoverPosZField`;
            $hoverFlag += " -hoverPosX " + $hx + " -hoverPosY " + $hy + " -hoverPosZ " + $hz;
        }
        int $useRigRot = `checkBoxGrp -query -value1 $bf_hoverUseRigRotCheck`;
        if (!$useRigRot) {
            float $hrx = `floatFieldGrp -query -value1 $bf_hoverRotXField`;
            float $hry = `floatFieldGrp -query -value1 $bf_hoverRotYField`;
            float $hrz = `floatFieldGrp -query -value1 $bf_hoverRotZField`;
            $hoverFlag += " -hoverRotX " + $hrx + " -hoverRotY " + $hry + " -hoverRotZ " + $hrz;
        }
        int $hNoise = `checkBoxGrp -query -value1 $bf_hoverNoiseCheck`;
        $hoverFlag += " -hoverNoise " + $hNoise;
        if ($hNoise) {
            float $hna = `floatFieldGrp -query -value1 $bf_hoverNoiseAmpField`;
            $hoverFlag += " -hoverNoiseAmp " + $hna;
        }
    }

    // Build follow-camera flags
    string $camFlag = "";
    int    $camOn   = `checkBoxGrp -query -value1 $bf_camEnableCheck`;
    if ($camOn) {
        string $camName = `textFieldGrp -query -text $bf_camNameField`;
        if ($camName == "") $camName = "BF_followCam";
        float  $stiff = `floatSliderGrp -query -value  $bf_camStiffSlider`;
        int    $useCur = `checkBoxGrp  -query -value1 $bf_camUseCurrentCheck`;

        $camFlag = " -createCamera 1"
                 + " -camName \"" + $camName + "\""
                 + " -camStiffness " + $stiff;

        if ($useCur) {
            // Offsets, rotation and FOV are derived in C++ from the
            // active 3D view camera — don't pass manual values.
            $camFlag += " -useCurrentCamera 1";
        } else {
            float  $cox = `floatFieldGrp -query -value1 $bf_camOffXField`;
            float  $coy = `floatFieldGrp -query -value1 $bf_camOffYField`;
            float  $coz = `floatFieldGrp -query -value1 $bf_camOffZField`;
            float  $crx = `floatFieldGrp -query -value1 $bf_camRotXField`;
            float  $cry = `floatFieldGrp -query -value1 $bf_camRotYField`;
            float  $crz = `floatFieldGrp -query -value1 $bf_camRotZField`;
            float  $fov = `floatFieldGrp -query -value1 $bf_camFOVField`;

            // Auto frame distance: override Z offset from FOV + Monarch wingspan
            int    $autoFrame = `checkBoxGrp -query -value1 $bf_camAutoFrameCheck`;
            if ($autoFrame) {
                float $fill = `floatSliderGrp -query -value $bf_camFillRatioSlider`;
                float $wingspan = 10.0;  // Monarch default (cm)
                $coz = bfCameraAutoDistance($fov, $fill, $wingspan);
            }

            $camFlag += " -camOffsetX " + $cox
                      + " -camOffsetY " + $coy
                      + " -camOffsetZ " + $coz
                      + " -camRotX "    + $crx
                      + " -camRotY "    + $cry
                      + " -camRotZ "    + $crz
                      + " -camFOV "     + $fov;
        }
    }

    // Build stationary-camera flags
    string $statCamFlag = "";
    int    $statOn = `checkBoxGrp -query -value1 $bf_statCamEnableCheck`;
    if ($statOn) {
        string $statName = `textFieldGrp -query -text $bf_statCamNameField`;
        if ($statName == "") $statName = "BF_statCam";
        int $statZoom = `checkBoxGrp -query -value1 $bf_statCamAutoZoomCheck`;
        $statCamFlag = " -createStatCam 1 -statCamName \"" + $statName + "\""
                     + " -statCamAutoZoom " + $statZoom;
    }

    // Call the C++ bfSimulate command directly
    // FPS is read from Maya's scene time unit automatically.
    string $cmd = "bfSimulate -rigRoot \"" + $rig + "\""
                  + " -startFrame " + $startF
                  + " -duration " + $duration
                  + " -flapPeriod " + $flapPeriod
                  + $pathFlag
                  + $velFlag
                  + $hoverFlag
                  + $swarmFlag
                  + $camFlag
                  + $statCamFlag;
    print ("// Executing: " + $cmd + "\n");

    if (catch(eval($cmd))) {
        confirmDialog
            -title "ButterFlight"
            -message "Simulation failed. Check the Script Editor for details."
            -button "OK";
        return;
    }

    inViewMessage
        -position "topCenter"
        -message ("ButterFlight: Simulation complete — " + $duration + " frames baked.")
        -fade;
}


// ============================================================
// Callback: Bake to Keyframes
// ============================================================
global proc bfBakeKeyframes()
{
    global string $bf_rigField;
    global string $bf_startFrameField;
    global string $bf_durationField;
    global string $bf_exportMenu;

    string $rig     = `textFieldButtonGrp -query -text $bf_rigField`;
    int    $startF  = `intFieldGrp -query -value1 $bf_startFrameField`;
    int    $duration = `intFieldGrp -query -value1 $bf_durationField`;
    int    $endF    = $startF + $duration - 1;
    int    $fmt     = `optionMenuGrp -query -select $bf_exportMenu`;

    if ($rig == "") {
        confirmDialog
            -title "ButterFlight"
            -message "No rig assigned. Run a simulation first."
            -button "OK";
        return;
    }

    print ("// ButterFlight: Baking keyframes " + $startF + " - " + $endF + "\n");

    // TODO: Call bakeResults on the rig hierarchy
    // select -hierarchy $rig;
    // bakeResults -simulation true -t ($startF + ":" + $endF) -sampleBy 1;

    if ($fmt == 2) {
        print "// ButterFlight: Export as Alembic (.abc)\n";
        // AbcExport -j ("-frameRange " + $startF + " " + $endF + " -root " + $rig + " -file output.abc");
    } else if ($fmt == 3) {
        print "// ButterFlight: Export as FBX (.fbx)\n";
        // FBXExport -f "output.fbx" -s;
    }

    inViewMessage
        -position "topCenter"
        -message "ButterFlight: Bake stub executed. Connect C++ plugin to enable."
        -fade;
}


// ============================================================
// Callback: Delete All Keys
//   Wipes every animation key from the rig hierarchy and from any
//   ButterFlight cameras in the scene (transform channels + shape
//   focalLength).  Destructive — confirms first.
// ============================================================
global proc bfDeleteAllKeys()
{
    global string $bf_rigField;
    global string $bf_camNameField;
    global string $bf_statCamNameField;

    string $rig = `textFieldButtonGrp -query -text $bf_rigField`;

    string $choice = `confirmDialog
        -title "ButterFlight"
        -message "Delete all animation keys from the rig hierarchy and ButterFlight cameras?\nThis cannot be undone via this dialog (use Ctrl+Z afterwards)."
        -button "Delete"
        -button "Cancel"
        -defaultButton "Cancel"
        -cancelButton "Cancel"`;
    if ($choice != "Delete") return;

    int $cleared = 0;

    if ($rig != "" && `objExists $rig`) {
        // Wipe every anim curve on the rig and all descendants.
        cutKey -clear -hierarchy below -time ":" $rig;
        $cleared++;
        print ("// ButterFlight: Cleared keys on '" + $rig + "' hierarchy.\n");
    }

    // Camera transforms: keys live on T/R channels.
    // Camera shapes: keys live on focalLength.
    string $camCandidates[] = {};
    string $camName = `textFieldGrp -query -text $bf_camNameField`;
    string $statCamName = `textFieldGrp -query -text $bf_statCamNameField`;
    if ($camName != "")     $camCandidates[size($camCandidates)] = $camName;
    if ($statCamName != "") $camCandidates[size($camCandidates)] = $statCamName;
    // Defaults in case the user hasn't customized the names.
    $camCandidates[size($camCandidates)] = "BF_followCam";
    $camCandidates[size($camCandidates)] = "BF_statCam";

    string $seen[] = {};  // dedupe list
    for ($cam in $camCandidates) {
        if ($cam == "" || !`objExists $cam`) continue;
        // Skip duplicates
        int $isDup = 0;
        for ($s in $seen) if ($s == $cam) { $isDup = 1; break; }
        if ($isDup) continue;
        $seen[size($seen)] = $cam;

        cutKey -clear -time ":" $cam;
        // Wipe focalLength on the shape (cutKey on transform doesn't
        // touch shape attributes).
        string $shapes[] = `listRelatives -shapes -fullPath $cam`;
        for ($shape in $shapes) {
            if (`attributeExists "focalLength" $shape`)
                cutKey -clear -time ":" -attribute "focalLength" $shape;
        }
        $cleared++;
        print ("// ButterFlight: Cleared keys on camera '" + $cam + "'.\n");
    }

    if ($cleared == 0) {
        confirmDialog
            -title "ButterFlight"
            -message "Nothing to delete: no rig assigned and no ButterFlight cameras found."
            -button "OK";
        return;
    }

    inViewMessage
        -position "topCenter"
        -message ("ButterFlight: Cleared keys on " + $cleared + " object(s).")
        -fade;
}


// ============================================================
// Callback: Reset / Clear
// ============================================================
global proc bfReset()
{
    global string $bf_rigField;
    global string $bf_pathField;
    global string $bf_pathFromStartCheck;
    global string $bf_pathSpeedEnableCheck;
    global string $bf_pathSpeedField;
    global string $bf_pathNoiseCheck;
    global string $bf_pathNoiseAmpField;
    global string $bf_pathDecelCheck;
    global string $bf_pathDecelPctField;
    global string $bf_pathDecelModeMenu;
    global string $bf_pathAngleBlendCheck;
    global string $bf_pathBlendRotXField;
    global string $bf_pathBlendRotYField;
    global string $bf_pathBlendRotZField;
    global string $bf_pathBlendPctField;
    global string $bf_pathBlendModeMenu;
    global string $bf_velocityField;
    global string $bf_modeMenu;
    global string $bf_startFrameField;
    global string $bf_durationField;
    global string $bf_flapPeriodField;
    global string $bf_hoverUseRigCheck;
    global string $bf_hoverPosXField;
    global string $bf_hoverPosYField;
    global string $bf_hoverPosZField;
    global string $bf_hoverUseRigRotCheck;
    global string $bf_hoverRotXField;
    global string $bf_hoverRotYField;
    global string $bf_hoverRotZField;
    global string $bf_hoverNoiseCheck;
    global string $bf_hoverNoiseAmpField;
    global string $bf_agentCountField;
    global string $bf_spawnSpreadField;
    global string $bf_repulsionRadField;
    global string $bf_camEnableCheck;
    global string $bf_camNameField;
    global string $bf_camUseCurrentCheck;
    global string $bf_camAutoFrameCheck;
    global string $bf_camOffXField;
    global string $bf_camOffYField;
    global string $bf_camOffZField;
    global string $bf_camRotXField;
    global string $bf_camRotYField;
    global string $bf_camRotZField;
    global string $bf_camStiffSlider;
    global string $bf_camFOVField;
    global string $bf_camFillRatioSlider;
    global string $bf_statCamEnableCheck;
    global string $bf_statCamNameField;
    global string $bf_statCamAutoZoomCheck;

    textFieldButtonGrp  -edit -text ""   $bf_rigField;
    textFieldButtonGrp  -edit -text ""   $bf_pathField;
    checkBoxGrp         -edit -value1 false $bf_pathFromStartCheck;
    checkBoxGrp         -edit -value1 false $bf_pathSpeedEnableCheck;
    floatFieldGrp       -edit -value1 1.0   $bf_pathSpeedField;
    bfPathSpeedToggle 0;
    checkBoxGrp         -edit -value1 false $bf_pathNoiseCheck;
    floatFieldGrp       -edit -value1 5.0 $bf_pathNoiseAmpField;
    checkBoxGrp         -edit -value1 false $bf_pathDecelCheck;
    floatFieldGrp       -edit -value1 10.0  $bf_pathDecelPctField;
    optionMenuGrp       -edit -select 2     $bf_pathDecelModeMenu;
    bfPathDecelToggle 0;
    checkBoxGrp         -edit -value1 false $bf_pathAngleBlendCheck;
    floatFieldGrp       -edit -value1 0.0   $bf_pathBlendRotXField;
    floatFieldGrp       -edit -value1 0.0   $bf_pathBlendRotYField;
    floatFieldGrp       -edit -value1 0.0   $bf_pathBlendRotZField;
    floatFieldGrp       -edit -value1 10.0  $bf_pathBlendPctField;
    optionMenuGrp       -edit -select 2     $bf_pathBlendModeMenu;
    bfPathAngleBlendToggle 0;
    floatFieldGrp       -edit -value1 0.5 $bf_velocityField;

    checkBoxGrp         -edit -value1 true $bf_hoverUseRigCheck;
    floatFieldGrp       -edit -value1 0.0  $bf_hoverPosXField;
    floatFieldGrp       -edit -value1 0.0  $bf_hoverPosYField;
    floatFieldGrp       -edit -value1 0.0  $bf_hoverPosZField;
    checkBoxGrp         -edit -value1 true $bf_hoverUseRigRotCheck;
    floatFieldGrp       -edit -value1 0.0  $bf_hoverRotXField;
    floatFieldGrp       -edit -value1 0.0  $bf_hoverRotYField;
    floatFieldGrp       -edit -value1 0.0  $bf_hoverRotZField;
    checkBoxGrp         -edit -value1 false $bf_hoverNoiseCheck;
    floatFieldGrp       -edit -value1 5.0   $bf_hoverNoiseAmpField;
    bfHoverToggle 0;
    bfHoverRotToggle 0;
    bfHoverNoiseToggle 0;

    optionMenuGrp -edit -select 3        $bf_modeMenu;

    intFieldGrp   -edit -value1 1        $bf_startFrameField;
    intFieldGrp   -edit -value1 120      $bf_durationField;
    floatFieldGrp -edit -value1 1.0      $bf_flapPeriodField;
    global string $bf_swarmEnableCheck;
    checkBoxGrp   -edit -value1 false    $bf_swarmEnableCheck;
    intFieldGrp   -edit -value1 10       $bf_agentCountField;
    floatFieldGrp -edit -value1 200.0    $bf_spawnSpreadField;
    floatFieldGrp -edit -value1 50.0     $bf_repulsionRadField;
    bfSwarmToggle 0;

    // Follow-camera defaults
    checkBoxGrp    -edit -value1 false   $bf_camEnableCheck;
    textFieldGrp   -edit -text "BF_followCam" $bf_camNameField;
    checkBoxGrp    -edit -value1 false   $bf_camUseCurrentCheck;
    checkBoxGrp    -edit -value1 true    $bf_camAutoFrameCheck;
    floatFieldGrp  -edit -value1 0.0     $bf_camOffXField;
    floatFieldGrp  -edit -value1 5.0     $bf_camOffYField;
    floatFieldGrp  -edit -value1 30.0    $bf_camOffZField;
    floatFieldGrp  -edit -value1 0.0     $bf_camRotXField;
    floatFieldGrp  -edit -value1 0.0     $bf_camRotYField;
    floatFieldGrp  -edit -value1 0.0     $bf_camRotZField;
    floatSliderGrp -edit -value 10.0     $bf_camStiffSlider;
    floatFieldGrp  -edit -value1 35.0    $bf_camFOVField;
    floatSliderGrp -edit -value 0.7      $bf_camFillRatioSlider;
    bfCameraToggle 0;

    // Stationary-camera defaults
    checkBoxGrp    -edit -value1 false      $bf_statCamEnableCheck;
    textFieldGrp   -edit -text "BF_statCam" $bf_statCamNameField;
    checkBoxGrp    -edit -value1 false      $bf_statCamAutoZoomCheck;
    bfStatCamToggle 0;

    bfUpdateMode;

    print "// ButterFlight: Panel reset to defaults.\n";
}


// ============================================================
// Menu bar integration
// ============================================================
global proc butterFlightMenu()
{
    global string $gMainWindow;

    // Remove existing menu if re-sourced
    if (`menu -exists bf_mainMenu`)
        deleteUI bf_mainMenu;

    menu -parent $gMainWindow
         -label "ButterFlight"
         -tearOff true
         bf_mainMenu;

        menuItem -label "Open ButterFlight..."
                 -command "butterFlightUI";

        menuItem -divider true;

        menuItem -label "Quick Simulate (Selected Rig)"
                 -command "bfSimulate -rigRoot \"BF_body\" -duration 120 -flapPeriod 1.0";
}

// ============================================================
// Auto-launch when sourced
// ============================================================
butterFlightMenu;
butterFlightUI;
